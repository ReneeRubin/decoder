# ---------------------------------------------------------------------------
# CLIENT (Vite) – öffentlich, landet im Browser-Bundle. NIEMALS Secrets hier!
# ---------------------------------------------------------------------------
VITE_APP_URL=https://rueckenbewusst-sein.de/decoder

# TODO: Echte Rückenkompass-Calendly-URL vom Auftraggeber eintragen.
VITE_CALENDLY_URL=

# TODO: URL des Brevo-Anmeldeformulars für Liste #24 eintragen (siehe
# docs/brevo-setup.md, Abschnitt "Reaktivierungs-Formular"). Ohne diesen
# Wert wird der "Keine E-Mail erhalten?"-Hinweis auf der Erfolgsseite
# ausgeblendet.
VITE_BREVO_REACTIVATION_FORM_URL=

# ---------------------------------------------------------------------------
# SERVER (Cloudflare Pages Functions) – als Secrets im Cloudflare Dashboard
# unter Pages-Projekt → Settings → Environment variables anlegen.
# NIEMALS in Git committen, NIEMALS im Frontend verwenden.
# ---------------------------------------------------------------------------

# TODO: Echten Brevo API Key eintragen (Brevo → Settings → SMTP & API → API Keys).
# Solange kein Key gesetzt ist, läuft die App automatisch im Brevo-Mock-Modus
# (siehe src/lib/brevo.ts).
BREVO_API_KEY=

# Bestehende Liste "Leadmagnet Schmerz Decoder"
BREVO_LIST_ID=24

QUIZ_VERSION=v1
