# ---------------------------------------------------------------------------
# CLIENT (Vite) – öffentlich, landet im Browser-Bundle. NIEMALS Secrets hier!
# ---------------------------------------------------------------------------
VITE_APP_URL=https://rueckenbewusst-sein.de/decoder

# TODO: Echte Rückenkompass-Calendly-URL vom Auftraggeber eintragen.
VITE_CALENDLY_URL=

# TODO: URL des Brevo-Anmeldeformulars für Liste #24 eintragen (siehe
# docs/brevo-setup.md, Abschnitt "Reaktivierungs-Formular"). Ohne diesen
# Wert wird der "Keine E-Mail erhalten?"-Hinweis auf der Erfolgsseite
# ausgeblendet.
VITE_BREVO_REACTIVATION_FORM_URL=

# TODO: Meta (Facebook) Pixel-ID eintragen (Meta Events Manager -> Datenquellen
# -> Pixel -> Einstellungen). Ohne diesen Wert bleibt der Pixel-Code in
# index.html inaktiv (No-op) und Meta trackt keine Leads. Siehe
# docs/meta-pixel-setup.md.
VITE_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# SERVER (Cloudflare Pages Functions) – als Secrets im Cloudflare Dashboard
# unter Pages-Projekt → Settings → Environment variables anlegen.
# NIEMALS in Git committen, NIEMALS im Frontend verwenden.
# ---------------------------------------------------------------------------

# TODO: Echten Brevo API Key eintragen (Brevo → Settings → SMTP & API → API Keys).
# Solange kein Key gesetzt ist, läuft die App automatisch im Brevo-Mock-Modus
# (siehe src/lib/brevo.ts).
BREVO_API_KEY=

# Bestehende Liste "Leadmagnet Schmerz Decoder"
BREVO_LIST_ID=24

QUIZ_VERSION=v1

# ---------------------------------------------------------------------------
# Digistore24-VIP-Webhook (functions/api/digistore24-webhook.ts)
# Siehe docs/digistore24-webhook-setup.md für die vollständige Anleitung.
# ---------------------------------------------------------------------------

# Brevo-Liste "VIP" (#26)
BREVO_VIP_LIST_ID=26

# Wert, der beim VIP-Kauf in das Brevo-Kontaktattribut VIP_2609 geschrieben wird.
BREVO_VIP_ATTRIBUTE_VALUE=vipaktiv

# Digistore24-Produkt-ID des VIP-Pakets (27 €)
DIGISTORE24_VIP_PRODUCT_ID=734497

# TODO: Nur als echtes Cloudflare Secret setzen (nicht in .dev.vars committen!).
# Muss exakt der Passphrase entsprechen, die in Digistore24 unter
# Produkt → Auslieferung → Webhook/IPN als "IPN-Passwort" hinterlegt ist.
DIGISTORE24_IPN_PASSPHRASE=
